PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai-chat-app
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=60000
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1h
CLIENT_URLS=http://localhost:5173
COOKIE_SAME_SITE=lax
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=10
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_LIMIT=30
RETAIN_USAGE_PROMPTS=false

# Configure SMTP to send password reset links. Reset tokens expire after 30 minutes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL=http://localhost:5173

# Used by automatic startup seeding and scripts/seedAdmin.js
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
